  "license": "MIT",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && npm run prepack && npm run build:cli",
    "build:cli": "vite build -c vite.cli.config.ts --mode production && chmod +x ./.cli/cli.js",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "prepack": "svelte-kit sync && npm run build:cli && svelte-package && publint",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "flc": "npm run format && npm run check && npm run lint",
    "start": "npx tiny migrate-to-latest && node build",
    "cli": "./.cli/cli.js",
    "tags": "git push --follow-tags",
    "minor": "npm version minor && npm run tags",
    "patch": "npm version patch && npm run tags",
    "test:unit": "vitest",
    "test:coverage": "vitest --coverage",
    "test": "npm run test:unit -- --run",
    "exports": "tsx ./src/lib/tiny/tools/exports.ts"
  },
  "bin": {
    "tiny": ".cli/cli.js"
  },
