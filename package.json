{
  "name": "@ampatspell/tiny",
  "version": "0.2.16",
  "license": "MIT",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && npm run prepack && npm run build:cli",
    "build:cli": "vite build -c vite.cli.config.ts --mode production && chmod +x ./.cli/cli.js",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "prepack": "svelte-kit sync && npm run build:cli && svelte-package && publint",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "flc": "npm run format && npm run check && npm run lint",
    "start": "npx tiny migrate-to-latest && node build",
    "cli": "./.cli/cli.js",
    "tags": "git push --follow-tags",
    "minor": "npm version minor && npm run tags",
    "patch": "npm version patch && npm run tags",
    "test:unit": "vitest",
    "test:coverage": "vitest --coverage",
    "test": "npm run test:unit -- --run",
    "exports": "tsx ./src/lib/tiny/tools/exports.ts"
  },
  "bin": {
    "tiny": ".cli/cli.js"
  },
  "files": [
    "dist",
    "src",
    ".cli"
  ],
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js"
    }
  },
  "peerDependencies": {
    "svelte": "^5.0.0",
    "@sveltejs/kit": "next"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@floating-ui/dom": "^1.8.0",
    "@fontsource/ubuntu-mono": "^5.3.0",
    "@sveltejs/adapter-node": "next",
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@types/fs-extra": "^11.0.4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24",
    "@types/slug": "^5.0.9",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.19.0",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^4.1.0",
    "publint": "^0.3.21",
    "sass-embedded": "^1.103.1",
    "svelte": "^5.56.1",
    "svelte-check": "^4.6.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.0.16",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "better-sqlite3": "^12.11.1",
    "date-fns": "^4.4.0",
    "dedent": "^1.7.2",
    "fs-extra": "^11.4.0",
    "jsonwebtoken": "^9.0.3",
    "kysely": "^0.29.5",
    "launch-editor": "^2.14.1",
    "sharp": "^0.35.4",
    "slug": "^12.0.1",
    "text-sentence-case": "^1.2.11",
    "valibot": "^1.4.2",
    "kysely-codegen": "^0.20.0"
  },
  "keywords": [
    "svelte"
  ],
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "better-sqlite3@12.11.1": true,
    "@parcel/watcher@2.6.0": true
  }
}
