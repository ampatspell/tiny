    "!src/tests/**/*",
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*",
    "!dist/playground/**/*",
    "!dist/tiny/server/database/migrations/**/*",
    "!dist/tiny/tools/**/*"
  ],
  "sideEffects": [
    "**/*.css",
