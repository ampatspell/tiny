{
  "name": "@ampatspell/tiny",
  "version": "0.1.6",
  "license": "MIT",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && npm run prepack && npm run build:cli",
    "build:cli": "vite build -c vite.cli.config.ts --mode production && chmod +x ./.cli/cli.js",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "prepack": "svelte-kit sync && svelte-package && npm run build:cli && publint",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "flc": "npm run format && npm run check && npm run lint",
    "start": "npx tsx src/lib/tools/cli.ts migrate-to-latest && node build",
    "cli": "./.cli/cli.js",
    "tags": "git push --follow-tags",
    "minor": "npm version minor && npm run tags",
    "patch": "npm version patch && npm run tags",
    "test:unit": "vitest",
    "test": "npm run test:unit -- --run"
  },
  "bin": {
    "tiny": ".cli/cli.js"
  },
  "files": [
    "dist",
    "src",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js"
    }
  },
  "peerDependencies": {
    "@sveltejs/kit": "^2.70.2",
    "svelte": "^5.56.9"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^24",
    "@types/resolve-path": "^1.4.3",
    "@types/slug": "^5.0.9",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "publint": "^0.3.23",
    "sass-embedded": "^1.102.0",
    "svelte": "^5.56.9",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.2.1",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@floating-ui/dom": "^1.8.0",
    "better-sqlite3": "^12.11.1",
    "date-fns": "^4.4.0",
    "dedent": "^1.7.2",
    "fs-extra": "^11.4.0",
    "kysely": "^0.29.4",
    "kysely-codegen": "^0.20.0",
    "launch-editor": "^2.14.1",
    "runed": "^0.37.1",
    "sharp": "^0.35.3",
    "slug": "^12.0.1",
    "text-sentence-case": "^1.2.11",
    "tinyexec": "^1.3.0",
    "tsx": "^4.23.12",
    "valibot": "^1.4.2"
  },
  "keywords": [
    "svelte"
  ]
}
