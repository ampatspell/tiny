{
  "name": "@ampatspell/tiny",
  "version": "0.0.1",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && npm run prepack",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "prepack": "svelte-kit sync && svelte-package && publint",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "flc": "npm run format && npm run check && npm run lint",
    "gen": "npx tsx ./src/lib/server/database/-gen.ts"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "svelte": "./dist/utils.js"
    },
    "./server/utils": {
      "types": "./dist/server/utils.d.ts",
      "svelte": "./dist/server/utils.js"
    },
    "./server/database": {
      "types": "./dist/server/database/database.d.ts",
      "svelte": "./dist/server/database/database.js"
    },
    "./server/files": {
      "types": "./dist/server/files.d.ts",
      "svelte": "./dist/server/files.js"
    },
    "./server/storage": {
      "types": "./dist/server/storage.d.ts",
      "svelte": "./dist/server/storage.js"
    },
    "./server/services": {
      "types": "./dist/server/services.d.ts",
      "svelte": "./dist/server/services.js"
    },
    "./components/backend/backend.svelte": {
      "types": "./dist/components/backend/backend.svelte.d.ts",
      "svelte": "./dist/components/backend/backend.svelte"
    },
    "./components/backend/navigation.svelte": {
      "types": "./dist/components/backend/navigation.svelte.d.ts",
      "svelte": "./dist/components/backend/navigation.svelte"
    },
    "./components/button.svelte": {
      "types": "./dist/components/button.svelte.d.ts",
      "svelte": "./dist/components/button.svelte"
    },
    "./components/dark.svelte": {
      "types": "./dist/components/dark.svelte.d.ts",
      "svelte": "./dist/components/dark.svelte"
    },
    "./components/files.svelte": {
      "types": "./dist/components/files.svelte.d.ts",
      "svelte": "./dist/components/files.svelte"
    },
    "./components/icon.svelte": {
      "types": "./dist/components/icon.svelte.d.ts",
      "svelte": "./dist/components/icon.svelte"
    },
    "./components/input.svelte": {
      "types": "./dist/components/input.svelte.d.ts",
      "svelte": "./dist/components/input.svelte"
    },
    "./components/json.svelte": {
      "types": "./dist/components/json.svelte.d.ts",
      "svelte": "./dist/components/json.svelte"
    }
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/adapter-node": "next",
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^24",
    "@types/resolve-path": "^1.4.3",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.19.0",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^4.1.0",
    "publint": "^0.3.21",
    "svelte": "^5.56.1",
    "svelte-check": "^4.6.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.0.16"
  },
  "dependencies": {
    "@sveltejs/kit": "next",
    "better-sqlite3": "^12.11.1",
    "date-fns": "^4.4.0",
    "dedent": "^1.7.2",
    "fast-folder-size": "^2.4.0",
    "fs-extra": "^11.4.0",
    "kysely": "^0.29.4",
    "kysely-codegen": "^0.20.0",
    "launch-editor": "^2.14.1",
    "resolve-path": "^1.4.0",
    "valibot": "^1.4.2"
  },
  "keywords": [
    "svelte"
  ],
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  }
}
